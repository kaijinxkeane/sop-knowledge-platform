# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / Next.js (future frontend)
node_modules/
.next/
out/
coverage/

# Test / eval artifacts
tests/workspace/
tests/results.json
.promptfoo/

# Local runtime data
.tmp/
*.log
spaces/**/.cache/
deploy/data/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# AI model files (never in git). Ollama keeps models in ~/.ollama, outside the
# repo; these rules catch weights or fine-tune output placed here by mistake.
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.mlmodel
*.mlpackage/
.ollama/
models/
!backend/app/models/
adapters/
!backend/app/models/adapters/
mlx_models/
fine-tune/output/
