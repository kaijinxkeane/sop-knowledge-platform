# Copy to .env (never commit .env). Used by docker compose and the backend.

SOP_ENV=development

# Claude API key. During development/testing: the developer's key, with demo data ONLY.
# Before the real vault is connected, replace with the company's key (plan §11).
ANTHROPIC_API_KEY=
# Optional: expected Anthropic organisation id in production (startup warns on mismatch).
ANTHROPIC_EXPECTED_ORG=

# Signs sign-in tokens and encrypts two-factor secrets. Required outside development.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and requires everyone to set up two-factor again.
SOP_SECRET_KEY=

# Postgres password for the bundled database (change for any non-dev install).
POSTGRES_PASSWORD=sop-dev-only
# Host port for the bundled database (5433 avoids clashing with a local Postgres on 5432).
POSTGRES_PORT=5433

# Local models (Ollama runs natively on the host).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Host folder holding the vault git repo (development: created by deploy/init-demo-vault.sh).
VAULT_HOST_PATH=./data/vault

LOG_LEVEL=INFO
